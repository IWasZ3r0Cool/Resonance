# Resonance runtime -----------------------------------------------------------
APP_ENV=development
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
MAX_UPLOAD_BYTES=10485760

# Local database --------------------------------------------------------------
# Relative paths are resolved from the directory where the API is started.
DATABASE_URL=file:./data/resonance.db?_pragma=foreign_keys(1)&_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)

# Model runtime ---------------------------------------------------------------
# Supported values: openai, gemini, ollama, openai-compatible
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini
LLM_BASE_URL=
LLM_API_KEY=

# Frontier-provider credentials. Leave unused providers empty.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Ollama example:
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:8b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama

# LM Studio / vLLM / other Responses-compatible endpoint example:
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=your-model-id
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=local

# Browser build ---------------------------------------------------------------
# Empty means same-origin. During development Vite proxies to the Go API.
# VITE_* values are public browser configuration: never put API keys here.
VITE_API_BASE_URL=
